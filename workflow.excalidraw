      "link": null,
      "locked": false,
      "text": "Rule 1: Foreign key is actully a bridge to connect to tables\nRule 2: Foreign key always leaves in the child tables\nRule 3: Foreign key always flow from child tables to parents tables",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rule 1: Foreign key is actully a bridge to connect to tables\nRule 2: Foreign key always leaves in the child tables\nRule 3: Foreign key always flow from child tables to parents tables",
      "autoResize": true,
      "lineHeight": 1.25
    },
