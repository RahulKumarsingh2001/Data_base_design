      "updated": 1789927230132,
      "link": null,
      "locked": false,
      "text": "Normalization is the process of organizing data in a database \nto reduce duplicate data and avoid data inconsistency.\n\nNormalization = Organizing data to reduce duplication.\n\n-> It aims to reduce data redundancy\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Normalization is the process of organizing data in a database \nto reduce duplicate data and avoid data inconsistency.\n\nNormalization = Organizing data to reduce duplication.\n\n-> It aims to reduce data redundancy\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
