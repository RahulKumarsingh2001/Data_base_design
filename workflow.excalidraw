    {
      "id": "keDaR6vcQSh6okRl2_kUT",
      "type": "text",
      "x": 134.6796875,
      "y": 127.98828125,
      "width": 510.99151611328125,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
